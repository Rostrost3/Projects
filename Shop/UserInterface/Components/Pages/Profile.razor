@page "/profile"

@inject SendRequestService SendRequestService
@inject ProductInfoService ProductInfoService
@inject ILocalStorage LocalStorage
@inject ForceExitService ForceExitService
@inject NavigationManager NavManager

@if (user is not null)
{
    <div class="d-flex justify-content-between">
        <h3>@user.UserName</h3>
        <Button @onclick="@ClickExit"><img src="images/exit.png" alt="exit icon" style="width: 50px; height: 50px;"></Button>
    </div>

    <ProductCards OnlyShowCartItems="true" />

    @if (@TotalPrice != 0)
    {
        <div class="d-flex justify-content-end mt-5 gap-3">
            <h2 class="mt-2">@TotalPrice руб.</h2>
            <Button @onclick="@MakeOrder" Color="ButtonColor.Primary" Size="ButtonSize.ExtraLarge">Make Order</Button>
        </div>
    }
}


@code {
    private UserDTO? user;

    decimal TotalPrice = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                using var response = await SendRequestService.SendAsync(HttpMethod.Get, "api/user/getuser");

                if (response!.IsSuccessStatusCode)
                {
                    using var responseStream = await response.Content.ReadAsStreamAsync();
                    user = await JsonSerializer.DeserializeAsync<UserDTO>(responseStream, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                }

                ProductInfoService.OnChange += () =>
                {
                    TotalPrice = ProductInfoService.GetCartTotalPrice();

                    StateHasChanged();
                };

                await ProductInfoService.LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SendRequestService] ERROR {ex.Message}");
            await ForceExitService.Exit();
        }
    }

    private async Task ClickExit()
    {
        NavManager.NavigateTo("/reg");
        await LocalStorage.RemoveKeyAsync();
    }

    private async Task MakeOrder()
    {
        await ProductInfoService.ClearCart();
        NavManager.NavigateTo("/");
    }
}

