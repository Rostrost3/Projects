@page "/addproduct"

@inject SendRequestService SendRequestService
@inject RoleService RoleService
@inject ForceExitService ForceExitService
@inject NavigationManager NavManager

<div class="d-flex flex-column justify-content-center align-items-center min-vh-100">
    <div class="card p-4" style="width: 100%; max-width: 400px;">
        <h3 class="text-center mb-4">Add Product</h3>

        <EditForm Model="@product" OnSubmit="Submit">
            <div class="mb-3">
                <label class="form-label">Name:</label>
                <TextInput @bind-Value="product.Name"></TextInput>
            </div>

            <div class="mb-3">
                <label class="form-label">Price:</label>
                <NumberInput @bind-Value="product.Price"></NumberInput>
            </div>

            <div class="mb-3">
                <InputFile OnChange="FileOnChange" />
            </div>

            <div class="d-flex justify-content-center">
                <Button Type="ButtonType.Submit" Color="ButtonColor.Primary">Add</Button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    const int maxAllowedSize = 2 * 1024 * 1024;

    ProductDTO product = new();

    string imageBase64 = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        bool isAdmin = await RoleService.IsAdmin();
        if (!isAdmin)
        {
            NavManager.NavigateTo("/");
        }
    }

    private async Task FileOnChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if(file != null)
        {
            using var stream = file.OpenReadStream(maxAllowedSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            imageBase64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
    }

    private async Task Submit()
    {
        try
        {  
            var json = JsonSerializer.Serialize(imageBase64);
            using var response = await SendRequestService.SendAsync(HttpMethod.Post, "api/product/saveimage", json);

            using var streamResponse = await response!.Content.ReadAsStreamAsync();
            product.ImageUrl = JsonSerializer.Deserialize<ImageResponse>(streamResponse, new JsonSerializerOptions { PropertyNameCaseInsensitive = true })!.ImageUrl;

            var json2 = JsonSerializer.Serialize(product);
            using var response2 = await SendRequestService.SendAsync(HttpMethod.Post, "api/product/addnew", json2);

            if(response2!.IsSuccessStatusCode)
            {
                NavManager.NavigateTo("/");
            }
        }
        catch(Exception ex)
        {
            Console.WriteLine($"ERROR {ex.Message}");
            await ForceExitService.Exit();
        }
    }
}
